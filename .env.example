# AI-Tiku 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# LLM 模型配置
MODEL_NAME=qwen3.5:2b
EMBEDDING_MODEL_NAME=nomic-embed-text
MODEL_TEMPERATURE=0.1

# Ollama 服务地址（可选，默认本地）
# OLLAMA_BASE_URL=http://localhost:11434

# 数据库配置（可选，使用默认路径）
# DATABASE_PATH=data/db.sqlite3
# EMBEDDINGS_DIR=data/embeddings

# API 配置
# API_PREFIX=/api
# DEBUG=false
